#!/usr/bin/env bash
# Pre-commit gate: format and lint the staged Python, type-check the project it
# belongs to and hold its imports to the layers contracts, and hold the staged
# Markdown to every aigarden rule. Tests are deliberately not here —
# `mise run check` and CI own them.
#
# Installed by `mise run setup`, which drops a dispatcher in the shared hooks
# dir that clears any inherited VIRTUAL_ENV and execs THIS script from the
# committing worktree. Binaries are called straight out of `.venv/bin` rather
# than through `uv run`, which is what keeps a clean tree under a second.
# Whatever a gate needs and does not find it installs once before giving up,
# so a fresh clone can commit before anyone runs `mise run setup` — given mise
# itself, which the hook asks for the pinned aigarden.
#
# Skip with `git commit --no-verify` only when you really mean it.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
venv="$repo_root/.venv"
ruff="$venv/bin/ruff"
pyrefly="$venv/bin/pyrefly"
lint_imports="$venv/bin/lint-imports"

if [[ ! -x "$ruff" || ! -x "$pyrefly" || ! -x "$lint_imports" ]]; then
  # A checkout nothing provisioned yet: provision it once, so the fast
  # direct-binary path below stays the common case.
  echo "pre-commit: missing venv under $repo_root — running tools/setup-worktree…" >&2
  "$repo_root/tools/setup-worktree"
  [[ -x "$ruff" && -x "$pyrefly" && -x "$lint_imports" ]] ||
    { echo "pre-commit: venv still incomplete — run 'mise run setup'." >&2; exit 1; }
fi

# Staged-only, additions/copies/modifications. NUL-delimited to survive
# pathological filenames. A plain `read` loop instead of `mapfile -d ''`
# because macOS still ships bash 3.2, where `mapfile -d` does not exist.
staged_py=()
while IFS= read -r -d '' f; do
  staged_py+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.py')

staged_md=()
while IFS= read -r -d '' f; do
  staged_md+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.md')

if ((${#staged_py[@]} == 0 && ${#staged_md[@]} == 0)); then
  exit 0
fi

cd "$repo_root"

if ((${#staged_py[@]} > 0)); then
  # `format --check` fails without rewriting anything — the author fixes it
  # rather than us restaging behind their back. It keeps its "N files already
  # formatted" line because `-q` also swallows its per-file I/O errors, and a
  # staged path that vanished from the tree would then exit 2 saying nothing.
  # `check` reports those as diagnostics, so `-q` there loses only the summary.
  "$ruff" format --check "${staged_py[@]}"
  "$ruff" check -q "${staged_py[@]}"

  # pyrefly needs the whole project for cross-module inference; per-file is
  # unsafe. Coverage is `project-includes` in pyproject.toml, which pyrefly
  # discovers from cwd — the same shape as `mise run typecheck`. Only invoked
  # because we know Python actually changed.
  VIRTUAL_ENV="$venv" "$pyrefly" check --progress-bar=no

  # The import contracts (`docs/layering.md`), whole-project for the same
  # reason: an edge is between packages, not inside a file, and like pyrefly
  # it reads the tree rather than the index. Uncached, as `mise.toml` explains.
  # A green run prints a logo and a line per contract, so capture and replay
  # only on a red one.
  if ! imports_out="$("$lint_imports" --no-cache 2>&1)"; then
    printf '%s\n' "$imports_out" >&2
    exit 1
  fi
fi

if ((${#staged_md[@]} > 0)); then
  # Verify mode, mirroring `ruff format --check`: a violation fails the commit
  # and the author runs `mise run lint-docs`. Every aigarden rule applies, not
  # just prose style — a link this commit breaks fails here instead of in CI.
  #
  # The version mise.toml pins, asked of mise from the repo root, never
  # `command -v`: mise re-resolves PATH only at an interactive prompt, so a
  # shell it activated in another directory keeps that one's aigarden first.
  if ! command -v mise >/dev/null; then
    echo "pre-commit: mise not found — install it, then run 'mise run setup'." >&2
    exit 1
  fi
  aigarden_bin="$(mise which aigarden 2>/dev/null || true)"
  if [[ -z "$aigarden_bin" ]]; then
    # The pin is declared but not installed. One tool, not a bare `mise
    # install`, which would fetch node and shellcheck to gate one document.
    # Spelled as mise.toml spells it: aigarden is not in mise's registry, so
    # the bare name would not resolve.
    echo "pre-commit: aigarden missing — bootstrapping it with mise…" >&2
    mise install github:nathanielobrown/aigarden >&2 || true
    aigarden_bin="$(mise which aigarden 2>/dev/null || true)"
  fi
  if [[ -z "$aigarden_bin" ]]; then
    echo "pre-commit: aigarden not found — run 'mise install'." >&2
    exit 1
  fi
  # aigarden prints a summary line on a clean run and has no --quiet, so
  # capture and replay only on a finding.
  #
  # Nothing to check is clean: a staged set aigarden's walk skips entirely
  # leaves it no files and a nonzero exit. The match stays on that one message
  # because a staged path missing from the tree also leaves it nothing to
  # check, and that one exits 2 with a different message and stays loud.
  if ! aigarden_out="$("$aigarden_bin" check "${staged_md[@]}" 2>&1)"; then
    case "$aigarden_out" in
    "aigarden: no files found"*) ;;
    *)
      printf '%s\n' "$aigarden_out" >&2
      exit 1
      ;;
    esac
  fi
fi
